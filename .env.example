TELEGRAM_BOT_TOKEN=
# ID преподавателей через запятую или * для доступа всем. Пустое значение запрещено.
# Свой числовой ID можно узнать командой /id в боте с открытым доступом.
TELEGRAM_ALLOWED_USER_IDS=
# PostgreSQL контейнер. Замените пароль перед запуском.
POSTGRES_DB=prepa
POSTGRES_USER=prepa
POSTGRES_PASSWORD=change_me
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_MAX_TOKENS=4096
# default: режим модели; off: отключить reasoning для проверки задержки/качества
OPENROUTER_REASONING=off
DATABASE_URL=postgresql://prepa:change_me@localhost:5432/prepa
LATEX_ENGINE=xelatex
LATEX_FONT=DejaVu Serif

# off: только запросы; demo: заглушки; real: OpenRouter + ФИПИ + проверка, JSON без PDF
PREPARATION_MODE=off

# Verified existing task corpus, mounted locally; no model-generated conditions.
# Live source (explicit local corpus is available for offline development only).
SOURCE_PROVIDER=reshai
SOURCE_CORPUS_PATH=
